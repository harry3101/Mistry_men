# Server
PORT=5000
NODE_ENV=development

# MongoDB — replace with your connection string
MONGODB_URI=mongodb://127.0.0.1:27017/mistry

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# AI chat (MistryBot) — get key from Lovable / AI gateway
LOVABLE_API_KEY=your_lovable_api_key_here

# Gmail SMTP — required for confirmation emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Mistry Service Center <your_gmail@gmail.com>"
ADMIN_NOTIFY_EMAIL=your_gmail@gmail.com
